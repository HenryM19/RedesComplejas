# Ejemplo de variables de entorno
# Copia este archivo a .env si necesitas agregar configuración adicional

# Puerto en el que corre el servidor
# (Render lo proporciona automáticamente)
PORT=8000

# Modo de depuración (desactiva en producción)
DEBUG=False

# Directorio base por defecto para proyectos
# BASE_PROJECTS_DIR=/home/user/projects

# Rutas personalizadas para templates
# TEMPLATES_DIR=/custom/path/to/templates
